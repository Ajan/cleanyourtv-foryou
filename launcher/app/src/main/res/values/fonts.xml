<?xml version="1.0" encoding="utf-8"?>
<!-- Local change (not upstream): the redesign uses Inter (res/font/inter*.xml) instead of Outfit.
     The UI fonts, looked up through these strings so a locale can swap in a system family: Outfit has no
     glyphs for most Vietnamese accented letters, so values-vi points them at the system sans-serif (#833). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/inter_regular</string>
    <string name="font_regular" translatable="false">@font/inter_regular</string>
    <string name="font_light" translatable="false">@font/inter_light</string>
    <string name="font_extralight" translatable="false">@font/inter_light</string>
    <string name="font_medium" translatable="false">@font/inter_medium</string>
    <!-- Local change (not upstream): the redesign's Inter weights 600 and 700. -->
    <string name="font_semibold" translatable="false">@font/inter_semibold</string>
    <string name="font_bold" translatable="false">@font/inter_bold</string>
</resources>
