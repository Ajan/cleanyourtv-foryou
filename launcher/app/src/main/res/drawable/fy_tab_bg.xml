<?xml version="1.0" encoding="utf-8"?>
<!-- Local change (not upstream): For You tabs. Focused: white pill. Selected (shown tab): frosted pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
