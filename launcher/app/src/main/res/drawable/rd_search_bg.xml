<?xml version="1.0" encoding="utf-8"?>
<!-- Local change (not upstream), redesign: the Search pill. White 10% at rest, solid white when focused; no outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/rd_focus" /><corners android:radius="100dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/rd_search_fill" /><corners android:radius="100dp" /></shape>
    </item>
</selector>
