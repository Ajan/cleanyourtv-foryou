<?xml version="1.0" encoding="utf-8"?>
<!-- Local change (not upstream), redesign: Launcher settings rows for the greeting and the tabs (RedesignSettings). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/rdNameChoice"
        style="@style/SettingsRow"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/rdGreetingChoice"
        style="@style/SettingsRow"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/rdPopularChoice"
        style="@style/SettingsRow"
        android:layout_marginTop="10dp" />
</LinearLayout>
