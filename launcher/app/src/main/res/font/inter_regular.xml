<?xml version="1.0" encoding="utf-8"?>
<!-- Local change (not upstream): Inter at weight 400 (redesign). inter.ttf is Inter's variable font subset to Latin
     with its optical size fixed, about 106 KB; SIL Open Font License 1.1 (launcher/fonts/INTER-OFL.txt). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/inter"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        tools:targetApi="28" />
</font-family>
